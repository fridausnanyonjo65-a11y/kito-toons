rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 120;
    }

    function isValidFavorite(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.movieId is string && data.movieId.size() <= 128
        && data.movieTitle is string && data.movieTitle.size() <= 200;
    }

    function isValidHistory(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.movieId is string && data.movieId.size() <= 128
        && data.movieTitle is string && data.movieTitle.size() <= 200;
    }

    function isValidMessage(data) {
      return data.name is string && data.name.size() <= 120
        && data.email is string && data.email.size() <= 256
        && data.message is string && data.message.size() <= 2000;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Movies catalog - readable by all visitors
    match /movies/{movieId} {
      allow get, list: if true;
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId);

      // User favorites
      match /favorites/{favoriteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFavorite(incoming());
        allow update: if isOwner(userId) && isValidFavorite(incoming());
        allow delete: if isOwner(userId);
      }

      // User watch history
      match /history/{historyId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidHistory(incoming());
        allow delete: if isOwner(userId);
      }
    }

    // Contact messages
    match /messages/{messageId} {
      allow create: if isValidMessage(incoming());
      allow read, update, delete: if false;
    }
  }
}
